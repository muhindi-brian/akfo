# Production .env — upload to server as .env (do not commit secrets to git)
# Generate APP_KEY: openssl rand -hex 16

APP_NAME="Agnes Kagure Foundation"
APP_URL="https://agneskagurefoundation.org"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Africa/Nairobi
APP_LOCALE=en
APP_KEY=REPLACE_WITH_openssl_rand_hex_16

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=akfo
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
