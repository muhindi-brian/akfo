APP_NAME="Agnes Kagure Foundation"

# Local (XAMPP subdirectory):
APP_URL="http://localhost/stitch_agnes_kagure_foundation_portal"

# Production (agneskagurefoundation.org — uncomment and use on the live server):
# APP_URL="https://agneskagurefoundation.org"
# APP_ENV=production
# APP_DEBUG=false

APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Africa/Nairobi
APP_LOCALE=en
APP_KEY=change-this-to-a-random-32-char-string

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=akfo
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
