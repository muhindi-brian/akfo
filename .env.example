# =============================================================================
# Agnes Kagure Foundation — Environment Configuration
# Copy to .env and adjust for your environment:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="Agnes Kagure Foundation"

# Local (XAMPP subdirectory):
APP_URL="http://localhost/stitch_agnes_kagure_foundation_portal"

# Production (uncomment on live server):
# APP_URL="https://agneskagurefoundation.org"

APP_ENV=local
# APP_ENV=production

APP_DEBUG=true
# APP_DEBUG=false

APP_TIMEZONE=Africa/Nairobi
APP_LOCALE=en

# Generate a unique key for production (e.g. openssl rand -hex 16)
APP_KEY=change-this-to-a-random-32-char-string

# -----------------------------------------------------------------------------
# Database (optional — site runs on static PHP data files today)
# -----------------------------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=akfo
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
